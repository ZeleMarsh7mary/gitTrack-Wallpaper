{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitWallpaper Settings",
  "mainBinaryName": "git-wallpaper-settings",
  "version": "0.1.0",
  "identifier": "com.gitwallpaper.settings",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitWallpaper Settings",
        "width": 980,
        "height": 650,
        "minWidth": 820,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
